<resources>
    <style name="Theme.PocketPet" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sage</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:textColor">@color/bark</item>
        <item name="android:textColorPrimary">@color/bark</item>
        <!-- bubble font everywhere (bundled Fredoka) -->
        <item name="android:fontFamily">@font/fredoka</item>
        <item name="fontFamily">@font/fredoka</item>
    </style>

    <!-- ===== Kawaii HUD (main screen only) ===== -->
    <style name="Hud.Label" parent="">
        <item name="android:fontFamily">@font/fredoka_medium</item>
        <item name="android:textColor">#6B4A3A</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Hud.Button" parent="Widget.AppCompat.Button">
        <item name="android:fontFamily">@font/fredoka_bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
