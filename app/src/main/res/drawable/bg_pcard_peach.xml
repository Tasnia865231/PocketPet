<?xml version="1.0" encoding="utf-8"?>
<!-- storybook card in a pastel colour: soft shadow, dashed stitching (same build as bg_store_card) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#26000000"/><corners android:radius="22dp"/></shape></item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="#FFE7DA"/><corners android:radius="22dp"/><stroke android:width="2dp" android:color="#F2C6AE"/></shape>
    </item>
    <item android:bottom="9dp" android:top="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle"><solid android:color="#00000000"/><corners android:radius="17dp"/>
            <stroke android:width="1.2dp" android:color="#EDB99D" android:dashWidth="5dp" android:dashGap="4dp"/></shape>
    </item>
</layer-list>
