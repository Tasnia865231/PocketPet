<?xml version="1.0" encoding="utf-8"?>
<!-- Big cream status panel: soft drop shadow, warm border, a few pastel hearts -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#26000000"/><corners android:radius="24dp"/></shape></item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FCF1DC"/>
            <corners android:radius="24dp"/>
            <stroke android:width="2dp" android:color="#EAD7B4"/>
        </shape>
    </item>
    <item android:bottom="9dp" android:top="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="19dp"/>
            <stroke android:width="1.2dp" android:color="#E7D2AC" android:dashWidth="5dp" android:dashGap="4dp"/>
        </shape>
    </item>
    <item android:gravity="top|end" android:width="11dp" android:height="11dp" android:top="11dp" android:end="14dp" android:drawable="@drawable/ic_heart_tiny_pink"/>
    <item android:gravity="bottom|start" android:width="11dp" android:height="11dp" android:bottom="17dp" android:start="14dp" android:drawable="@drawable/ic_heart_tiny_pink"/>
</layer-list>
