<?xml version="1.0" encoding="utf-8"?>
<!-- the chat input bar: cream paper with a pink outline and stitched inner line -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#FFF8EA"/>
        <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
        <stroke android:width="2.5dp" android:color="#F08FB0"/></shape></item>
    <item android:top="5dp" android:left="6dp" android:right="6dp"><shape android:shape="rectangle"><solid android:color="#00000000"/>
        <corners android:topLeftRadius="21dp" android:topRightRadius="21dp"/>
        <stroke android:width="1.2dp" android:color="#F7C3D5" android:dashWidth="5dp" android:dashGap="4dp"/></shape></item>
</layer-list>
