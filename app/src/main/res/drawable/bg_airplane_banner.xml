<?xml version="1.0" encoding="utf-8"?>
<!-- airplane-mode banner: pastel sky card, soft shadow, gentle blue outline, dashed stitching, tiny hearts -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp"><shape android:shape="rectangle"><solid android:color="#33000000"/><corners android:radius="28dp"/></shape></item>
    <item android:bottom="4dp"><shape android:shape="rectangle"><solid android:color="#E6F3FC"/><corners android:radius="28dp"/><stroke android:width="2.5dp" android:color="#8FC4E8"/></shape></item>
    <item android:bottom="10dp" android:top="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle"><solid android:color="#00000000"/><corners android:radius="22dp"/>
            <stroke android:width="1.4dp" android:color="#B9DAF0" android:dashWidth="6dp" android:dashGap="4dp"/></shape>
    </item>
    <item android:gravity="top|end" android:width="12dp" android:height="12dp" android:top="12dp" android:end="18dp" android:drawable="@drawable/ic_heart_tiny_pink"/>
    <item android:gravity="bottom|start" android:width="12dp" android:height="12dp" android:bottom="18dp" android:start="18dp" android:drawable="@drawable/ic_heart_tiny_pink"/>
</layer-list>
