<?xml version="1.0" encoding="utf-8"?>
<!-- slim rounded progress bar: pastel track + coloured fill (fill follows the real stat value) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#EADFCB"/>
            <corners android:radius="6dp"/>
            <stroke android:width="1dp" android:color="#DCCDB0"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#B2D69C" android:endColor="#86B873"/>
                <corners android:radius="6dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
