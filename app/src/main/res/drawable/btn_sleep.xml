<?xml version="1.0" encoding="utf-8"?>
<!-- btn_sleep: raised pastel button with dashed stitching + tiny hearts. Pressed = pushed down, disabled = muted. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#38000000"/><corners android:radius="18dp"/></shape></item>
            <item android:bottom="3dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#BDCCD2"/>
                    <corners android:radius="18dp"/>
                    <stroke android:width="2dp" android:color="#9DAFBA"/>
                </shape>
            </item>
            <item android:bottom="3dp" android:top="0dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#D0DBDF"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item android:bottom="7dp" android:top="4dp" android:left="5dp" android:right="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000"/>
                    <corners android:radius="13dp"/>
                    <stroke android:width="1.5dp" android:color="#CCFFFFFF" android:dashWidth="5dp" android:dashGap="3dp"/>
                </shape>
            </item>
            <item android:gravity="top|end" android:width="12dp" android:height="12dp" android:top="4dp" android:end="9dp" android:drawable="@drawable/ic_heart_tiny"/>
            <item android:gravity="bottom|start" android:width="12dp" android:height="12dp" android:bottom="7dp" android:start="9dp" android:drawable="@drawable/ic_heart_tiny"/>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#38000000"/><corners android:radius="18dp"/></shape></item>
            <item android:bottom="3dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#8ABAE1"/>
                    <corners android:radius="18dp"/>
                    <stroke android:width="2dp" android:color="#5C96CB"/>
                </shape>
            </item>
            <item android:bottom="3dp" android:top="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#C3DFF6"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item android:bottom="7dp" android:top="6dp" android:left="5dp" android:right="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000"/>
                    <corners android:radius="13dp"/>
                    <stroke android:width="1.5dp" android:color="#CCFFFFFF" android:dashWidth="5dp" android:dashGap="3dp"/>
                </shape>
            </item>
            <item android:gravity="top|end" android:width="12dp" android:height="12dp" android:top="6dp" android:end="9dp" android:drawable="@drawable/ic_heart_tiny"/>
            <item android:gravity="bottom|start" android:width="12dp" android:height="12dp" android:bottom="7dp" android:start="9dp" android:drawable="@drawable/ic_heart_tiny"/>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#38000000"/><corners android:radius="18dp"/></shape></item>
            <item android:bottom="3dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#93C6F0"/>
                    <corners android:radius="18dp"/>
                    <stroke android:width="2dp" android:color="#5C96CB"/>
                </shape>
            </item>
            <item android:bottom="3dp" android:top="0dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#C3DFF6"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item android:bottom="7dp" android:top="4dp" android:left="5dp" android:right="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000"/>
                    <corners android:radius="13dp"/>
                    <stroke android:width="1.5dp" android:color="#CCFFFFFF" android:dashWidth="5dp" android:dashGap="3dp"/>
                </shape>
            </item>
            <item android:gravity="top|end" android:width="12dp" android:height="12dp" android:top="4dp" android:end="9dp" android:drawable="@drawable/ic_heart_tiny"/>
            <item android:gravity="bottom|start" android:width="12dp" android:height="12dp" android:bottom="7dp" android:start="9dp" android:drawable="@drawable/ic_heart_tiny"/>
        </layer-list>
    </item>
</selector>
