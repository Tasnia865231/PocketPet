<?xml version="1.0" encoding="utf-8"?>
<!-- btn_nav_shop: raised pastel button with dashed stitching + tiny hearts. Pressed = pushed down, disabled = muted. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#38000000"/><corners android:radius="14dp"/></shape></item>
            <item android:bottom="3dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#E4C8B4"/>
                    <corners android:radius="14dp"/>
                    <stroke android:width="2dp" android:color="#CFAA97"/>
                </shape>
            </item>
            <item android:bottom="3dp" android:top="0dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#ECD8CA"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <item android:bottom="7dp" android:top="4dp" android:left="5dp" android:right="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000"/>
                    <corners android:radius="9dp"/>
                    <stroke android:width="1.5dp" android:color="#CCFFFFFF" android:dashWidth="5dp" android:dashGap="3dp"/>
                </shape>
            </item>
            <item android:gravity="top|end" android:width="10dp" android:height="10dp" android:top="4dp" android:end="7dp" android:drawable="@drawable/ic_heart_tiny"/>
            <item android:gravity="bottom|start" android:width="10dp" android:height="10dp" android:bottom="7dp" android:start="7dp" android:drawable="@drawable/ic_heart_tiny"/>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#38000000"/><corners android:radius="14dp"/></shape></item>
            <item android:bottom="3dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#EAAF99"/>
                    <corners android:radius="14dp"/>
                    <stroke android:width="2dp" android:color="#D98B72"/>
                </shape>
            </item>
            <item android:bottom="3dp" android:top="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#FBD9CC"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <item android:bottom="7dp" android:top="6dp" android:left="5dp" android:right="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000"/>
                    <corners android:radius="9dp"/>
                    <stroke android:width="1.5dp" android:color="#CCFFFFFF" android:dashWidth="5dp" android:dashGap="3dp"/>
                </shape>
            </item>
            <item android:gravity="top|end" android:width="10dp" android:height="10dp" android:top="6dp" android:end="7dp" android:drawable="@drawable/ic_heart_tiny"/>
            <item android:gravity="bottom|start" android:width="10dp" android:height="10dp" android:bottom="7dp" android:start="7dp" android:drawable="@drawable/ic_heart_tiny"/>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#38000000"/><corners android:radius="14dp"/></shape></item>
            <item android:bottom="3dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#F9BBA3"/>
                    <corners android:radius="14dp"/>
                    <stroke android:width="2dp" android:color="#D98B72"/>
                </shape>
            </item>
            <item android:bottom="3dp" android:top="0dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#FBD9CC"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <item android:bottom="7dp" android:top="4dp" android:left="5dp" android:right="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000"/>
                    <corners android:radius="9dp"/>
                    <stroke android:width="1.5dp" android:color="#CCFFFFFF" android:dashWidth="5dp" android:dashGap="3dp"/>
                </shape>
            </item>
            <item android:gravity="top|end" android:width="10dp" android:height="10dp" android:top="4dp" android:end="7dp" android:drawable="@drawable/ic_heart_tiny"/>
            <item android:gravity="bottom|start" android:width="10dp" android:height="10dp" android:bottom="7dp" android:start="7dp" android:drawable="@drawable/ic_heart_tiny"/>
        </layer-list>
    </item>
</selector>
