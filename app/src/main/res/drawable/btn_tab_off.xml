<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#38000000"/><corners android:radius="16dp"/></shape></item>
            <item android:bottom="3dp" android:top="2dp"><shape android:shape="rectangle"><solid android:color="#F4E7CD"/><corners android:radius="16dp"/><stroke android:width="2dp" android:color="#D9C4A0"/></shape></item>
            <item android:bottom="3dp" android:top="2dp" android:left="2dp" android:right="2dp"><shape android:shape="rectangle"><gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#FFF6E2"/><corners android:radius="14dp"/></shape></item>
            <item android:bottom="7dp" android:top="6dp" android:left="5dp" android:right="5dp"><shape android:shape="rectangle"><solid android:color="#00000000"/><corners android:radius="11dp"/><stroke android:width="1.5dp" android:color="#B3D9C4A0" android:dashWidth="5dp" android:dashGap="3dp"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#38000000"/><corners android:radius="16dp"/></shape></item>
            <item android:bottom="3dp" android:top="1dp"><shape android:shape="rectangle"><solid android:color="#F4E7CD"/><corners android:radius="16dp"/><stroke android:width="2dp" android:color="#D9C4A0"/></shape></item>
            <item android:bottom="3dp" android:top="1dp" android:left="2dp" android:right="2dp"><shape android:shape="rectangle"><gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#FFF6E2"/><corners android:radius="14dp"/></shape></item>
            <item android:bottom="7dp" android:top="5dp" android:left="5dp" android:right="5dp"><shape android:shape="rectangle"><solid android:color="#00000000"/><corners android:radius="11dp"/><stroke android:width="1.5dp" android:color="#B3D9C4A0" android:dashWidth="5dp" android:dashGap="3dp"/></shape></item>
        </layer-list>
    </item>
</selector>
