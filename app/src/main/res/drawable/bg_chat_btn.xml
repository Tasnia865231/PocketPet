<?xml version="1.0" encoding="utf-8"?>
<!-- round-ish pastel pink chat button: soft shadow, gentle outline; pressed = pushed down -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#33000000"/><corners android:radius="20dp"/></shape></item>
            <item android:top="2dp" android:bottom="1dp"><shape android:shape="rectangle"><solid android:color="#FFC2D6"/><corners android:radius="20dp"/><stroke android:width="2.5dp" android:color="#E0708A"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#33000000"/><corners android:radius="20dp"/></shape></item>
            <item android:bottom="3dp"><shape android:shape="rectangle"><solid android:color="#FFDCE8"/><corners android:radius="20dp"/><stroke android:width="2.5dp" android:color="#F08FB0"/></shape></item>
        </layer-list>
    </item>
</selector>
