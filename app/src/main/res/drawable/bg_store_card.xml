<?xml version="1.0" encoding="utf-8"?>
<!-- storybook item card: cream, soft shadow, dashed stitching -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#26000000"/><corners android:radius="22dp"/></shape></item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="#FFF8EA"/><corners android:radius="22dp"/><stroke android:width="2dp" android:color="#EAD7B4"/></shape>
    </item>
    <item android:bottom="9dp" android:top="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle"><solid android:color="#00000000"/><corners android:radius="17dp"/>
            <stroke android:width="1.2dp" android:color="#E7D2AC" android:dashWidth="5dp" android:dashGap="4dp"/></shape>
    </item>
</layer-list>
