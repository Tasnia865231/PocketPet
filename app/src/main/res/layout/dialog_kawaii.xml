<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_kawaii" android:gravity="center_horizontal"
    android:orientation="vertical" android:paddingBottom="26dp" android:paddingHorizontal="26dp" android:paddingTop="22dp">
    <ImageView android:id="@+id/dlgIcon" android:layout_width="84dp" android:layout_height="84dp"
        android:src="@drawable/ic_mochi_happy" />
    <TextView android:id="@+id/dlgTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="@font/fredoka_bold" android:gravity="center"
        android:textColor="#5B3F30" android:textSize="22sp" />
    <TextView android:id="@+id/dlgMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="@font/fredoka_medium" android:gravity="center"
        android:textColor="#8A6A55" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:orientation="horizontal">
        <com.example.pocketpet.view.BubbleButton android:id="@+id/dlgNo" style="@style/Hud.Button"
            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:background="@drawable/btn_nav_share"
            android:textSize="16sp" app:outlineColor="#417F9C" app:outlineWidth="2.5dp" />
        <com.example.pocketpet.view.BubbleButton android:id="@+id/dlgYes" style="@style/Hud.Button"
            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:layout_marginStart="6dp" android:background="@drawable/btn_bath"
            android:textSize="16sp" app:outlineColor="#B84F74" app:outlineWidth="3dp" />
    </LinearLayout>
</LinearLayout>
