<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- ===== Main content (always visible) ===== -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Title row + coins -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingTop="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/title" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/coins" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="16sp" />
            </LinearLayout>
            <!-- Level badge + XP bar -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/levelBadge" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textStyle="bold" android:paddingEnd="6dp" />
                <ProgressBar android:id="@+id/barXp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp" android:layout_height="6dp"
                    android:layout_weight="1" android:max="100" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pet view (takes all remaining space) -->
        <com.example.pocketpet.view.PetView android:id="@+id/petView"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Stat bars -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content"
                    android:text="Hunger" android:textSize="12sp" />
                <ProgressBar android:id="@+id/barHunger" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:max="100" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content"
                    android:text="Energy" android:textSize="12sp" />
                <ProgressBar android:id="@+id/barEnergy" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:max="100" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content"
                    android:text="Mood" android:textSize="12sp" />
                <ProgressBar android:id="@+id/barMood" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:max="100" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="72dp" android:layout_height="wrap_content"
                    android:text="Clean" android:textSize="12sp" />
                <ProgressBar android:id="@+id/barClean" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:max="100" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary action buttons: Feed, Play, Sleep/Wake, Bath -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="8dp">
            <Button android:id="@+id/btnFeed" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:insetLeft="2dp" android:insetRight="2dp"
                android:paddingHorizontal="0dp" android:text="Feed" android:textSize="12sp" />
            <Button android:id="@+id/btnPlay" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:insetLeft="2dp" android:insetRight="2dp"
                android:paddingHorizontal="0dp" android:text="Play" android:textSize="12sp" />
            <Button android:id="@+id/btnSleep" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:insetLeft="2dp" android:insetRight="2dp"
                android:paddingHorizontal="0dp" android:text="Sleep" android:textSize="12sp" />
            <Button android:id="@+id/btnClean" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:insetLeft="2dp" android:insetRight="2dp"
                android:paddingHorizontal="0dp" android:text="Bath" android:textSize="12sp" />
        </LinearLayout>

        <!-- Secondary nav buttons: Shop, Bag, Stats, Share, Settings -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="8dp" android:paddingBottom="8dp">
            <Button android:id="@+id/btnShop" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:insetLeft="2dp" android:insetRight="2dp"
                android:paddingHorizontal="0dp" android:text="Shop" android:textSize="12sp" />
            <Button android:id="@+id/btnBag" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:insetLeft="2dp" android:insetRight="2dp"
                android:paddingHorizontal="0dp" android:text="Bag" android:textSize="12sp" />
            <Button android:id="@+id/btnStats" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:insetLeft="2dp" android:insetRight="2dp"
                android:paddingHorizontal="0dp" android:text="Stats" android:textSize="12sp" />
            <Button android:id="@+id/btnShare" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:insetLeft="2dp" android:insetRight="2dp"
                android:paddingHorizontal="0dp" android:text="Share" android:textSize="12sp" />
            <Button android:id="@+id/btnSettings" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:insetLeft="2dp" android:insetRight="2dp"
                android:paddingHorizontal="0dp" android:text="Settings" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Food menu overlay (bottom panel, GONE by default) ===== -->
    <LinearLayout android:id="@+id/foodPanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#EEF3E6CF"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Choose food:" android:textSize="15sp" android:textStyle="bold" />
            <Button android:id="@+id/btnCloseFoodPanel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Close" android:textSize="12sp" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/foodRecycler"
            android:layout_width="match_parent" android:layout_height="110dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- ===== Bath "Done" button (GONE by default, shown during bathing) ===== -->
    <Button android:id="@+id/btnBathDone"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="200dp"
        android:text="Done"
        android:visibility="gone" />

</FrameLayout>
