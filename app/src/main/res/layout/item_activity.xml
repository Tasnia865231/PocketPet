<?xml version="1.0" encoding="utf-8"?>
<!-- One community moment: icon, sentence, time. Background colour set by ActivityAdapter (by event type). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingBottom="16dp" android:paddingHorizontal="16dp" android:paddingTop="12dp">

    <ImageView
        android:id="@+id/activityIcon"
        android:layout_width="26dp" android:layout_height="26dp"
        android:layout_marginEnd="12dp" android:contentDescription="Activity" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView
            android:id="@+id/activityText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_medium" android:textColor="#5B4636" android:textSize="15sp" />
        <TextView
            android:id="@+id/activityTime"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_medium" android:textColor="#B59A86" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
