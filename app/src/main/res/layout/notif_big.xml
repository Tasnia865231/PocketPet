<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_card" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/notif_icon" android:layout_width="56dp" android:layout_height="56dp"
            android:src="@drawable/ic_mochi_happy" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/notif_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_bold" android:maxLines="1" android:textColor="#5B3F30" android:textSize="17sp" />
            <TextView android:id="@+id/notif_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_medium" android:textColor="#8A6A55" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/notif_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp"
        android:max="100" android:minHeight="8dp" android:maxHeight="8dp"
        android:progressDrawable="@drawable/bar_energy" android:visibility="gone" />
    <LinearLayout android:id="@+id/notif_buttons" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/notif_btn1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:background="@drawable/bg_notif_btn_pink" android:gravity="center"
            android:fontFamily="@font/fredoka_bold" android:paddingBottom="2dp" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/notif_btn2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:layout_marginStart="6dp" android:background="@drawable/bg_notif_btn_sage" android:gravity="center"
            android:fontFamily="@font/fredoka_bold" android:paddingBottom="2dp" android:textColor="#FFFFFF" android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
