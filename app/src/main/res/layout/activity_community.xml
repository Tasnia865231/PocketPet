<?xml version="1.0" encoding="utf-8"?>
<!-- Community screen, built like the Shop: header, two coloured tabs, one section visible at a time.
     Tab 1 = Mochi Friends (who is online + coins), Tab 2 = What is happening (live activity feed). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F6EBD4" android:orientation="vertical"
    android:paddingHorizontal="14dp" android:paddingTop="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <com.example.pocketpet.view.BubbleButton android:id="@+id/btnBack" style="@style/Hud.Button"
            android:layout_width="wrap_content" android:layout_height="38dp"
            android:background="@drawable/btn_nav_share" android:paddingHorizontal="16dp"
            android:textSize="14sp" app:outlineColor="#417F9C" app:outlineWidth="2.5dp" android:text="Back" />
        <TextView android:id="@+id/title" style="@style/Hud.Label" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
            android:fontFamily="@font/fredoka_bold" android:text="Community"
            android:textColor="#5B3F30" android:textSize="28sp" />
        <TextView android:id="@+id/onlineChip" style="@style/Hud.Label" android:layout_width="wrap_content"
            android:layout_height="38dp" android:background="@drawable/bg_chip_online" android:gravity="center"
            android:fontFamily="@font/fredoka_bold" android:paddingHorizontal="14dp"
            android:paddingBottom="2dp" android:text="0 online" android:textColor="#3F7F5A" android:textSize="16sp" />
    </LinearLayout>

    <TextView android:id="@+id/subtitle" style="@style/Hud.Label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center"
        android:textSize="14sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <com.example.pocketpet.view.BubbleButton android:id="@+id/tabFriends" style="@style/Hud.Button"
            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:layout_marginHorizontal="4dp" android:background="@drawable/btn_tab_mint_on"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp"
            android:paddingHorizontal="8dp"
            app:outlineColor="#4F8F69" app:outlineWidth="3dp" android:text="Mochi Friends" />
        <com.example.pocketpet.view.BubbleButton android:id="@+id/tabFeed" style="@style/Hud.Button"
            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:layout_marginHorizontal="4dp" android:background="@drawable/btn_tab_off"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp"
            android:paddingHorizontal="8dp"
            app:outlineColor="#6E559A" app:outlineWidth="3dp" android:text="What is happening" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <!-- SECTION 1: Mochi Friends -->
        <FrameLayout android:id="@+id/sectionFriends"
            android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/listPlayers"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false" android:paddingTop="10dp" android:paddingBottom="16dp" />
            <TextView android:id="@+id/textEmptyPlayers" style="@style/Hud.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center" android:padding="28dp"
                android:text="Looking for friends..." android:textColor="#B59A86" android:textSize="17sp" />
        </FrameLayout>

        <!-- SECTION 2: What is happening -->
        <FrameLayout android:id="@+id/sectionFeed"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/listFeed"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false" android:paddingTop="10dp" android:paddingBottom="16dp" />
            <TextView android:id="@+id/textEmptyFeed" style="@style/Hud.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center" android:padding="28dp"
                android:text="Nothing yet. Level up Mochi and be the first!" android:textColor="#B59A86" android:textSize="17sp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
